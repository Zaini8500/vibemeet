# Copy to .env. Never commit a real .env. Never put these in the Android app.
DATABASE_URL=postgres://vibemeet:change-me@localhost:5432/vibemeet
REDIS_URL=redis://localhost:6379
PORT=8080
JWT_ACCESS_SECRET=change-me-long-random
JWT_REFRESH_SECRET=change-me-long-random-different
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=30d
GOOGLE_CLIENT_ID=
# TURN: the backend generates per-user time-limited credentials at runtime.
# The Android app requests them from GET /match/ice-servers (authenticated).
# TURN_SHARED_SECRET must match your TURN server's static-auth-secret.
TURN_URLS=
TURN_SHARED_SECRET=
TURN_REALM=vibemeet
# Google Play Billing verification (server-side only; never commit the key file).
GOOGLE_PLAY_PACKAGE_NAME=com.vibemeet.app
GOOGLE_PLAY_SERVICE_ACCOUNT_FILE=
# or GOOGLE_PLAY_SERVICE_ACCOUNT_JSON= (server env only, not in a file)
COIN_PACKAGES={"coins_100":100,"coins_500":500,"coins_1000":1000}
# Optional Phase 2/3 providers (interfaces only until you add keys):
MODERATION_PROVIDER_URL=
TRANSLATION_PROVIDER_URL=
TRANSLATION_API_KEY=
# Matching weights must sum to 1.0 (validated at startup).
MATCH_WEIGHTS={"interests":0.30,"language":0.20,"region":0.20,"preferences":0.20,"connection":0.10}
MAX_DAILY_MATCHES_FREE=50
